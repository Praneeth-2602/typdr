# ─────────────────────────────────────────────────────────────────────────────
# typdr — Environment Variables
# Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Auth (next-auth v4) ───────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical URL — required for redirects & CSRF
# Locally: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Optional shared password gate for credentials sign-in
# SWIFTKEYS_SHARED_PASSWORD=

# ── OAuth (optional) ──────────────────────────────────────────────────────────
GITHUB_ID=
GITHUB_SECRET=
GOOGLE_ID=
GOOGLE_SECRET=

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=
MONGODB_DB=typdr

# ── AI Drill Generation (at least one for AI drills / coach) ──────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
DRILL_PROVIDER=auto

# ── Certificates ──────────────────────────────────────────────────────────────
# HMAC secret for /cert/[id] verification. Falls back to NEXTAUTH_SECRET.
CERT_SIGNING_SECRET=

# ── Background Job Queue (optional) ───────────────────────────────────────────
UPSTASH_URL=
UPSTASH_TOKEN=
